{
  "schema_version": 1,
  "suite_id": "rl-v3-phase-c0",
  "description": "Single-scenario overfitting test. Determine whether MaskablePPO can master one trivial fixed task before any generalization work.",
  "seed": 42,
  "movement_contract": "v2-uav-routing-env/post_move_observed",
  "scenario": {
    "scenario_id": "C0-G015-EMPTY-FIXED",
    "grid_size": 15,
    "start": [2, 2],
    "goal": [12, 7],
    "blocked": [],
    "dynamic_obstacles": [],
    "stochastic_obstacles": [],
    "moving_obstacles": [],
    "traversal_penalties": [],
    "no_fly_cells": [],
