{
  "env": {
    "local_crop_size": 11,
    "global_map_size": 32,
    "grid_sizes": [15, 30, 50, 100],
    "corner_cutting": true,
    "max_steps_multiplier": 2.0
  },
  "curriculum": {
    "stages": [
      {
        "max_interactions": 25000,
        "active_sizes": [15, 30]
      },
      {
        "max_interactions": 75000,
        "active_sizes": [15, 30, 50]
      },
      {
        "max_interactions": 150000,
        "active_sizes": [15, 30, 50, 100]
      }
    ]
  },
  "reward": {
    "type": "R2-PB-empty-v1",
    "goal": 1.0,
    "collision": -1.0,
    "step_penalty_total_per_episode_budget": -0.2,
    "gamma": 0.99,
    "lambda_": 2.0
  },
  "observation": {
    "family": "global_local",
    "local_size": 11,
    "global_size": 32,
    "scalar_features": ["relative_goal_row", "relative_goal_column", "grid_size", "previous_action"]
  },
  "training": {
    "episode_budget_astar_multiplier": 2.0,
    "minimum_episode_budget": 10,
    "seed": 42
  },
  "scenario": {
    "grid_size": 15,
    "max_steps": 200,
    "start": [0, 0],
    "goal": [14, 14]
  },
  "model": {
    "n_steps": 2048,
    "batch_size": 64,
    "gamma": 0.99,
    "learning_rate": 3e-4,
    "ent_coef": 0.01
  }
}
