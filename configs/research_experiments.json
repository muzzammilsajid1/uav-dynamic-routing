{
  "schema_version": 1,
  "policy_seeds": [11, 22, 33, 44, 55],
  "layout_seed": 42,
  "grid_size": 15,
  "dynamics_timing": "post_move_observed",
  "model": {
    "learning_rate": 0.001,
    "buffer_size": 100000,
    "learning_starts": 5000,
    "batch_size": 256,
    "gamma": 0.99,
    "train_freq": 2,
    "gradient_steps": 1,
    "target_update_interval": 1000,
    "exploration_fraction": 0.5,
    "exploration_initial_eps": 1.0,
    "exploration_final_eps": 0.05,
    "network": [128, 128],
    "her_sampled_goals": 4
  },
  "stages": [
    {
      "name": "static",
      "timesteps": 300000,
      "obstacle_density": 0.2,
      "dynamic": "none",
      "curriculum_enabled": true
    },
    {
      "name": "dynamic_mild",
      "timesteps": 100000,
      "obstacle_density": 0.2,
      "dynamic": "mild",
      "curriculum_enabled": false
    },
    {
      "name": "dynamic_full",
      "timesteps": 100000,
      "obstacle_density": 0.2,
      "dynamic": "full",
      "curriculum_enabled": false
    }
  ],
  "variants": {
    "full": {
      "double_dqn": true,
      "her": true,
      "potential_shaping": true,
      "curriculum": true,
      "observation_mode": "local",
      "dynamic_from_scratch": false
    },
    "dqn": {
      "double_dqn": false,
      "her": true,
      "potential_shaping": true,
      "curriculum": true,
      "observation_mode": "local",
      "dynamic_from_scratch": false
    },
    "no_her": {
      "double_dqn": true,
      "her": false,
      "potential_shaping": true,
      "curriculum": true,
      "observation_mode": "local",
      "dynamic_from_scratch": false
    },
    "no_shaping": {
      "double_dqn": true,
      "her": true,
      "potential_shaping": false,
      "curriculum": true,
      "observation_mode": "local",
      "dynamic_from_scratch": false
    },
    "no_curriculum": {
      "double_dqn": true,
      "her": true,
      "potential_shaping": true,
      "curriculum": false,
      "observation_mode": "local",
      "dynamic_from_scratch": false
    },
    "full_observation": {
      "double_dqn": true,
      "her": true,
      "potential_shaping": true,
      "curriculum": true,
      "observation_mode": "full",
      "dynamic_from_scratch": false
    },
    "dynamic_from_scratch": {
      "double_dqn": true,
      "her": true,
      "potential_shaping": true,
      "curriculum": false,
      "observation_mode": "local",
      "dynamic_from_scratch": true,
      "stage_timesteps": {
        "dynamic_full": 500000
      }
    }
  }
}
